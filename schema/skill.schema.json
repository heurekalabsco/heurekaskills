{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heurekaskills.com/schema/skill.schema.json",
  "title": "Heurekaskills per-skill manifest (skill.json)",
  "type": "object",
  "required": ["schemaVersion", "slug", "name", "description", "category", "checksum", "files"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "enum": ["data", "models", "analysis", "utility", "communication"] },
    "version": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "attribution": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "covers": {
      "description": "Free-text discovery vocabulary — tissue, assay, organism, modality. Indexed for search; not rendered as filter chips.",
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1 }
    },
    "papers": {
      "description": "Provenance for the data this skill retrieves — the paper defining the resource, and papers that used it.",
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^(PMID:[0-9]{1,8}|doi:10\\.[0-9]{4,9}/\\S+)$" }
    },
    "access": {
      "description": "The route this skill documents. A data skill listing only 'controlled' has no lawful reader route and does not ship.",
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["open", "registered", "controlled"] }
    },
    "platform": {
      "description": "Shared infrastructure behind this source (e.g. snovault, hive-elasticsearch), so grammar drift can be swept across every skill using it.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "updatedAt": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["repo", "commit", "path"],
      "properties": {
        "repo": { "type": "string" },
        "commit": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "url", "size", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
